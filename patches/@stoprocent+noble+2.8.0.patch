+// `GattCommunicationStatus::ProtocolError` alone just means "the device
+// sent back an ATT-level error response" without saying which one — the
+// underlying single-byte ATT error code (Bluetooth Core Spec, Attribute
+// Protocol) is what actually distinguishes "needs pairing" (0x05/0x0f/0x08)
+// from every other rejection reason, and WinRT only exposes it via the
+// separate nullable `ProtocolError()` property on Gatt read/write results.
+// Without decoding it, every protocol-level rejection looks identical
+// ("Protocol error") no matter the real cause.
+std::string attErrorCodeToString(uint8_t code) {
+    switch (code) {
+        case 0x01: return "Invalid Handle";
+        case 0x02: return "Read Not Permitted";
+        case 0x03: return "Write Not Permitted";
+        case 0x04: return "Invalid PDU";
+        case 0x05: return "Insufficient Authentication (device likely requires pairing/bonding)";
+        case 0x06: return "Request Not Supported";
+        case 0x07: return "Invalid Offset";
+        case 0x08: return "Insufficient Authorization (device likely requires pairing/bonding)";
+        case 0x09: return "Prepare Queue Full";
+        case 0x0A: return "Attribute Not Found";
+        case 0x0B: return "Attribute Not Long";
+        case 0x0C: return "Insufficient Encryption Key Size";
+        case 0x0D: return "Invalid Attribute Value Length";
+        case 0x0E: return "Unlikely Error";
+        case 0x0F: return "Insufficient Encryption (device likely requires pairing/bonding)";
+        case 0x10: return "Unsupported Group Type";
+        case 0x11: return "Insufficient Resources";
+        default:
+            if (code >= 0x80 && code <= 0x9F) return "Application Error (device-specific)";
+            char buf[24];
+            snprintf(buf, sizeof(buf), "ATT error 0x%02x", code);
+            return std::string(buf);
+    }
+}
+
+template <typename TResult>
+std::string gattWriteStatusToString(const TResult& result) {
+    auto status = result.Status();
+    std::string message = gattStatusToString(status);
+    if (status == GattCommunicationStatus::ProtocolError) {
+        auto protocolError = result.ProtocolError();
+        if (protocolError) {
+            message += ": " + attErrorCodeToString(protocolError.Value());
+        }
+    }
+    return message;
+}
